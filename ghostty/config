# ═══════════════════════════════════════════════════════════════════════════
#  Ghostty Configuration — EVILWARE theme (ported from Alacritty)
#  True-black OLED bg, electric cyan fg, hot-crimson accent. eDEX-UI homage.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Window ──────────────────────────────────────────────────────────────────
# Start fullscreen, filling the entire screen edge-to-edge (content extends up
# into the notch row). Hides the menu bar.
fullscreen = non-native
# `fullscreen` only sets the STARTUP state; the Cmd+Ctrl+F toggle obeys this key.
# `true` = same fill-everything non-native mode, so re-entering fullscreen still
# fills the notch area instead of falling back to native (which blacks it out).
macos-non-native-fullscreen = true
background-opacity = 0.96
macos-window-shadow = false
# Right Option = Alt/Meta so Neovim/tmux M-/Alt- bindings work (e.g. snacks
# picker <A-w> cycle_win), including Caps Lock remapped to Option (which macOS
# sends as Right Option); left Option still types special chars like Ω.
macos-option-as-alt = right
window-padding-x = 6
window-padding-y = 6
# Spread the leftover space (window height not evenly divisible by cell height)
# across all edges instead of dumping it as a gap on the bottom/right.
window-padding-balance = true
# Fill the padding with the nearest cell's actual color rather than the static
# `background` value. Without this the edges show a gray frame in fullscreen,
# because the nvim autocmds change the live bg (OSC 11) but padding wouldn't.
# `extend-always` skips the heuristic that leaves thin gray lines at edges whose
# row/column has mixed colors (e.g. the tmux status bar).
window-padding-color = extend-always
# false = borderless window: removes the macOS chrome that draws a gray
# rounded-corner outline around the view in non-native fullscreen. Tradeoff:
# no title bar / traffic-light buttons when running windowed.
# true = restore the macOS title bar + traffic-light buttons (windowed mode).
window-decoration = true
# dimensions in grid cells (columns x rows), mirrors alacritty [window.dimensions]
window-width = 120
window-height = 36
# dynamic title is on by default in Ghostty (matches dynamic_title = true)

# ─── Scrolling ───────────────────────────────────────────────────────────────
# Alacritty history was 10000 lines; Ghostty's limit is in BYTES, not lines.
# ~10 MB comfortably exceeds 10k lines of scrollback.
scrollback-limit = 10000000
mouse-scroll-multiplier = 3

# ─── Font ────────────────────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font"
font-size = 14
# Alacritty font.offset y = 2 (extra line spacing); closest Ghostty knob:
adjust-cell-height = 2

# ─── ABSTRACT palette (from abstract-background.jpg) ────────────────────────────────────────────────────────
background = 080418
foreground = CECBE5

# cursor (alacritty [colors.cursor])
cursor-color = E08C9D
cursor-text = 080418

# selection (alacritty [colors.selection])
selection-foreground = EBE9F4
selection-background = 292C60

# normal colors 0-7 (alacritty [colors.normal])
palette = 0=#1C1C40
palette = 1=#C47164
palette = 2=#87C9B3
palette = 3=#CEB37E
palette = 4=#82ADF6
palette = 5=#B597C9
palette = 6=#67ADFB
palette = 7=#AEA9D3
# bright colors 8-15 (alacritty [colors.bright])
palette = 8=#3A407C
palette = 9=#D58C81
palette = 10=#A5D6C6
palette = 11=#DDC698
palette = 12=#A1C1F8
palette = 13=#CBB6D9
palette = 14=#95C6FC
palette = 15=#EBE9F4
# indexed highlights (alacritty [[colors.indexed_colors]])
palette = 16=#E08C9D
palette = 17=#67ADFB
# Note: Ghostty has no direct equivalent for alacritty's dim_foreground,
# bright_foreground, [colors.dim], vi_mode_cursor, search, hints, or footer_bar.

# ─── Cursor ──────────────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = true
# (unfocused cursor renders hollow by default, matching unfocused_hollow = true)

# ─── Selection / clipboard ───────────────────────────────────────────────────
copy-on-select = clipboard

# ─── Mouse ───────────────────────────────────────────────────────────────────
mouse-hide-while-typing = true

# ─── Environment ─────────────────────────────────────────────────────────────
# Alacritty forced TERM=xterm-256color. Ghostty defaults to xterm-ghostty;
# override to match (avoids "missing terminfo" on remote hosts).
term = xterm-256color

# ─── Keybindings (ported from alacritty [[keyboard.bindings]]) ────────────────
keybind = shift+enter=text:\x1b\r
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
# Named keys (minus, zero, equal) match the physical US-layout position; on a
# Nordic layout the `+` key sits at US `minus`, so ctrl+minus fired on Ctrl++.
# Unbind the physical one and bind by the character the layout actually types.
keybind = ctrl+minus=unbind
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# ─── Shell ───────────────────────────────────────────────────────────────────
# fish: grey history-based autosuggestions out of the box
command = /usr/bin/fish
